# Required
TYPESAFE_API_KEY=ts_...            # from https://console.typesafe.ai/keys
JEV_OWNER_PASSWORD=change-me       # typed on the consent page when an agent connects
JEV_PUBLIC_URL=https://jev.example.com

# Optional (defaults shown)
# JEV_DB_PATH=/data/jev.db
# JEV_HOST=0.0.0.0
# JEV_PORT=8080
# JEV_DEFAULT_MODEL=jev-latest
# JEV_ACCESS_TOKEN_TTL=3600
# JEV_REFRESH_TOKEN_TTL=2592000
# JEV_LOG_LEVEL=info
# JEV_ALLOW_INSECURE_URL=1         # only for local development over http://
